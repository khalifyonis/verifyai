# ==============================================================================
# VERIFAI Backend Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="VERIFAI"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security (Change in production!)
SECRET_KEY="replace-with-a-secure-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: Async SQLite (zero setup)
DATABASE_URL="sqlite+aiosqlite:///./verifai.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://verifai_user:verifai_password@localhost:5432/verifai"

# External AI & Vision Services (Optional)
GEMINI_API_KEY=""
AI_FALLBACK_MODE=true
